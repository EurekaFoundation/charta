<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.graphics">
<office:font-face-decls><style:font-face style:name="Liberation Serif" svg:font-family="'Liberation Serif'"/></office:font-face-decls>
<office:styles><style:default-style style:family="graphic"><style:graphic-properties draw:fill="solid" draw:fill-color="#729fcf" draw:stroke="solid" svg:stroke-color="#3465a4"/><style:text-properties fo:font-size="18pt"/></style:default-style></office:styles>
<office:automatic-styles>
<style:page-layout style:name="PM1"><style:page-layout-properties fo:margin-top="1cm" fo:margin-bottom="1cm" fo:margin-left="1cm" fo:margin-right="1cm" fo:page-width="21cm" fo:page-height="14.8cm"/></style:page-layout>
<style:style style:name="dp1" style:family="drawing-page"><style:drawing-page-properties draw:fill="solid" draw:fill-color="#fff8e7"/></style:style>
<style:style style:name="gr1" style:family="graphic"><style:graphic-properties draw:fill="solid" draw:fill-color="#e76f51" draw:stroke="none"/></style:style>
<style:style style:name="gr2" style:family="graphic"><style:graphic-properties draw:fill="none" draw:stroke="none" fo:padding="0.1cm"/></style:style>
<style:style style:name="gr3" style:family="graphic"><style:graphic-properties draw:stroke="solid" svg:stroke-color="#264653" svg:stroke-width="0.1cm"/></style:style>
<style:style style:name="gr4" style:family="graphic"><style:graphic-properties draw:fill="solid" draw:fill-color="#264653" draw:stroke="solid" svg:stroke-color="#e9c46a" svg:stroke-width="0.08cm"/></style:style>
<style:style style:name="P1" style:family="paragraph"><style:paragraph-properties fo:text-align="center"/></style:style>
<style:style style:name="T1" style:family="text"><style:text-properties fo:font-size="28pt" fo:font-weight="bold" fo:color="#264653" style:font-name="Liberation Serif"/></style:style>
<style:style style:name="T2" style:family="text"><style:text-properties fo:font-size="12pt" fo:color="#333333" fo:font-style="italic"/></style:style>
</office:automatic-styles>
<office:master-styles><style:master-page style:name="Default" style:page-layout-name="PM1"/></office:master-styles>
<office:body><office:drawing><draw:page draw:name="p1" draw:style-name="dp1" draw:master-page-name="Default">
<draw:rect draw:style-name="gr1" svg:x="1cm" svg:y="1cm" svg:width="19cm" svg:height="2cm" draw:corner-radius="0.4cm"/>
<draw:frame draw:style-name="gr2" svg:x="1.5cm" svg:y="3.5cm" svg:width="18cm" svg:height="2cm"><draw:text-box><text:p text:style-name="P1"><text:span text:style-name="T1">Festa di primavera</text:span></text:p><text:p text:style-name="P1"><text:span text:style-name="T2">Sabato in piazza,</text:span><text:s text:c="2"/><text:span text:style-name="T2">ore 18</text:span></text:p></draw:text-box></draw:frame>
<draw:frame svg:x="1.5cm" svg:y="6.5cm" svg:width="6cm" svg:height="4cm"><draw:image><office:binary-data></office:binary-data></draw:image></draw:frame>
<draw:ellipse draw:style-name="gr4" svg:x="9cm" svg:y="6.5cm" svg:width="4cm" svg:height="4cm"><text:p>Gratis</text:p></draw:ellipse>
<draw:rect draw:style-name="gr1" svg:width="3cm" svg:height="1.5cm" draw:transform="rotate (0.5235987756) translate (15cm 8cm)"/>
<draw:line draw:style-name="gr3" svg:x1="1cm" svg:y1="12cm" svg:x2="20cm" svg:y2="13cm"/>
<draw:g><draw:polygon draw:style-name="gr4" svg:x="14cm" svg:y="10.5cm" svg:width="2cm" svg:height="2cm" svg:viewBox="0 0 100 100" draw:points="50,0 100,100 0,100"/>
<draw:path draw:style-name="gr1" svg:x="17cm" svg:y="10.5cm" svg:width="2cm" svg:height="2cm" svg:viewBox="0 0 2000 2000" svg:d="M0 1000 C0 0 2000 0 2000 1000 L1000 2000 Z"/></draw:g>
</draw:page></office:drawing></office:body></office:document>